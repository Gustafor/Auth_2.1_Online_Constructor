"React + vite-plugin-react + react-router-dom OAuth client"
import { createBrowserClient } from "./lib/oauth";
import { createRouter } from "./router";

const clientId = import.meta.env.VITE_{{ provider | upper }}_CLIENT_ID;
const redirectUri = import.meta.env.VITE_OAUTH_REDIRECT_URI;
const scopes = "{{ scopes }}".split(",");

const oauth = createBrowserClient({
  provider: "{{ provider }}",
  clientId,
  redirectUri,
  scopes,
  pkce: {{ pkce | lower }},
  flow: "{{ flow }}",
});

async function handleLogin() {
  try {
    const { url, codeVerifier } = await oauth.generateAuthorizationUrl();
    localStorage.setItem("oauth_code_verifier", codeVerifier);
    window.location.href = url;
  } catch (error) {
    console.error("Failed to start OAuth flow:", error);
  }
}

async function handleCallback() {
  const params = new URLSearchParams(window.location.search);
  const code = params.get("code");
  const error = params.get("error");

  if (error) {
    console.error("OAuth error:", error);
    return;
  }

  if (!code) {
    return;
  }

  const codeVerifier = localStorage.getItem("oauth_code_verifier");
  try {
    const tokens = await oauth.exchangeCode(code, codeVerifier);
    localStorage.setItem("access_token", tokens.access_token);
    window.location.href = "/";
  } catch (error) {
    console.error("Failed to exchange code:", error);
  }
}

const router = createRouter({
  routes: [
    { path: "/login", element: <button onClick={handleLogin}>Sign in</button> },
    { path: "/callback", element: <div onMount={handleCallback}>Signing in...</div> },
  ],
});

const root = document.getElementById("root");
root?.replaceChildren(router.render());
