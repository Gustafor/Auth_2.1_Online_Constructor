# OAuth 2.1 / OpenID Connect Constructor Configuration
# Copy this file to .env and fill in your values if running locally

# Application settings
APP_NAME=auth-2.1-constructor
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supported identity providers
SUPPORTED_PROVIDERS=google,github,yandex,vk,custom_oidc

# Supported application types
SUPPORTED_APP_TYPES=spa,web,native,cli,server_server

# Supported frontend stacks
SUPPORTED_STACKS=react,vue,nextjs,fastapi,express,php,go
